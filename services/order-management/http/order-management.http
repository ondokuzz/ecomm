# Exercises every Order Management endpoint against the compose stack (`docker compose up -d --build`).
# Run the requests top to bottom in the IntelliJ HTTP client; the token requests store tokens for
# the ones after them.

@orders = http://localhost:8085
@keycloak = http://localhost:8180/realms/ecomm/protocol/openid-connect/token
@userinfo = http://localhost:8180/realms/ecomm/protocol/openid-connect/userinfo

### Customer token
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=dev-cli&username=demo@ecomm.local&password=demo&scope=openid

> {% client.global.set("customerToken", response.body.access_token); %}

### The demo Customer's ID: the sub Checkout names in the body
GET {{userinfo}}
Authorization: Bearer {{customerToken}}

> {% client.global.set("customerId", response.body.sub); %}

### Checkout token: Checkout's own identity, for the internal endpoints
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=checkout&client_secret=checkout-dev-secret

> {% client.global.set("checkoutToken", response.body.access_token); %}

### Checkout places an Order for the Customer: 201 with the Order in PLACED, its subtotal, tax, total
### and its Order Status history, its placement by CHECKOUT
POST {{orders}}/orders
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "lines": [
  {"variantId": "PHN-PIXEL-9", "quantity": 2, "unitPrice": {"amountMinor": 79900, "currency": "EUR"}},
  {"variantId": "AUD-AIRPODS-PRO-2", "quantity": 1, "unitPrice": {"amountMinor": 14950, "currency": "EUR"}}
],
 "tax": {"amountMinor": 34950, "currency": "EUR"}}

> {% client.global.set("orderId", response.body.id); %}

### With a Discount: the total is the lines, less the discount, plus the tax
POST {{orders}}/orders
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "lines": [
  {"variantId": "PHN-PIXEL-9", "quantity": 1, "unitPrice": {"amountMinor": 79900, "currency": "EUR"}}
],
 "discount": {"couponCode": "WELCOME10", "amount": {"amountMinor": 7990, "currency": "EUR"}},
 "tax": {"amountMinor": 14382, "currency": "EUR"}}

> {% client.global.set("discountedOrderId", response.body.id); %}

### The Customer reads the first one back with their own token
GET {{orders}}/orders/{{orderId}}
Authorization: Bearer {{customerToken}}

### Checkout marks it paid after authorizing the payment: its history gains PAID
PATCH {{orders}}/orders/{{orderId}}/status
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json
X-Correlation-Id: http-file-pay-1

{"customerId": "{{customerId}}", "status": "PAID"}

### Paid, then cancelled: the history shows PLACED, then PAID, then CANCELLED
PATCH {{orders}}/orders/{{discountedOrderId}}/status
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "status": "PAID"}

###
PATCH {{orders}}/orders/{{discountedOrderId}}/status
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "status": "CANCELLED"}

### An illegal transition, PAID to DELIVERED: 409, the history unchanged and no event published
PATCH {{orders}}/orders/{{orderId}}/status
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "status": "DELIVERED"}

### Naming a Customer who doesn't own the Order: 404
PATCH {{orders}}/orders/{{orderId}}/status
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "someone-else", "status": "CANCELLED"}

### The Customer's Orders, newest first: the first page of 20, with how many they have in all
GET {{orders}}/orders
Authorization: Bearer {{customerToken}}

### Two to a page: the second page
GET {{orders}}/orders?page=1&size=2
Authorization: Bearer {{customerToken}}

### A size out of range: 400
GET {{orders}}/orders?size=101
Authorization: Bearer {{customerToken}}

### An unknown Order: 404
GET {{orders}}/orders/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{customerToken}}

### Lines in two currencies: 400
POST {{orders}}/orders
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "lines": [
  {"variantId": "PHN-PIXEL-9", "quantity": 1, "unitPrice": {"amountMinor": 79900, "currency": "EUR"}},
  {"variantId": "AUD-AIRPODS-PRO-2", "quantity": 1, "unitPrice": {"amountMinor": 14950, "currency": "USD"}}
],
 "tax": {"amountMinor": 0, "currency": "EUR"}}

### A discount larger than the lines plus the tax: 400
POST {{orders}}/orders
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "lines": [
  {"variantId": "PHN-PIXEL-9", "quantity": 1, "unitPrice": {"amountMinor": 79900, "currency": "EUR"}}
],
 "discount": {"couponCode": "TOOMUCH", "amount": {"amountMinor": 99999, "currency": "EUR"}},
 "tax": {"amountMinor": 0, "currency": "EUR"}}

### No tax: 400; Checkout always sends it, even when zero
POST {{orders}}/orders
Authorization: Bearer {{checkoutToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "lines": [
  {"variantId": "PHN-PIXEL-9", "quantity": 1, "unitPrice": {"amountMinor": 79900, "currency": "EUR"}}
]}

### A Customer can't place an Order, only Checkout can: 403
POST {{orders}}/orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "lines": [
  {"variantId": "PHN-PIXEL-9", "quantity": 1, "unitPrice": {"amountMinor": 1, "currency": "EUR"}}
],
 "tax": {"amountMinor": 0, "currency": "EUR"}}

### A Customer can't change their Order's status, only Checkout can: 403
PATCH {{orders}}/orders/{{orderId}}/status
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "status": "CANCELLED"}

### Without a token: 401
GET {{orders}}/orders

### Staff token
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=dev-cli&username=staff@ecomm.local&password=staff

> {% client.global.set("staffToken", response.body.access_token);
     client.global.set("orderReference", client.global.get("orderId").substring(0, 8).toUpperCase()); %}

### Staff have no Orders of their own: 403
GET {{orders}}/orders
Authorization: Bearer {{staffToken}}

### Staff list every Customer's Orders, newest first, with how many there are in all
GET {{orders}}/staff/orders
Authorization: Bearer {{staffToken}}

### Filtered: the demo Customer's paid Orders
GET {{orders}}/staff/orders?customerId={{customerId}}&status=PAID
Authorization: Bearer {{staffToken}}

### Placed in October 2026, from its first instant up to, not including, November's
GET {{orders}}/staff/orders?placedFrom=2026-10-01T00:00:00Z&placedTo=2026-11-01T00:00:00Z&size=5
Authorization: Bearer {{staffToken}}

### By the Order reference a Customer quotes, such as #3F2A9C1B: the first Order
GET {{orders}}/staff/orders?idPrefix={{orderReference}}
Authorization: Bearer {{staffToken}}

### An unknown Status: 400
GET {{orders}}/staff/orders?status=LOST
Authorization: Bearer {{staffToken}}

### Staff open the Customer's Order: its Customer ID and its history, each change's time and caller
GET {{orders}}/staff/orders/{{orderId}}
Authorization: Bearer {{staffToken}}

### Staff can't change an Order: 403
PATCH {{orders}}/orders/{{orderId}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{"customerId": "{{customerId}}", "status": "CANCELLED"}

### A Customer can't browse every Order: 403
GET {{orders}}/staff/orders
Authorization: Bearer {{customerToken}}

###
GET {{orders}}/staff/orders/{{orderId}}
Authorization: Bearer {{customerToken}}
