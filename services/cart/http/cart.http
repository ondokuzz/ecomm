# Exercises every Cart endpoint against the compose stack (`docker compose up -d --build`).
# Run the requests top to bottom in the IntelliJ HTTP client; the token request stores a token for
# the ones after it.

@cart = http://localhost:8083
@keycloak = http://localhost:8180/realms/ecomm/protocol/openid-connect/token

### Customer token
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=dev-cli&username=demo@ecomm.local&password=demo&scope=openid

> {% client.global.set("customerToken", response.body.access_token); %}

### The Customer's Cart: empty until they add something
GET {{cart}}/cart
Authorization: Bearer {{customerToken}}

### Put a Variant in the Cart: 200 with the whole Cart
PUT {{cart}}/cart/items/PHN-PIXEL-9
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"quantity": 2}

### Another Variant
PUT {{cart}}/cart/items/AUD-JBL-FLIP-6
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"quantity": 1}

### Change a quantity: it replaces the old one
PUT {{cart}}/cart/items/PHN-PIXEL-9
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"quantity": 3}

### A quantity that isn't a positive integer: 400
PUT {{cart}}/cart/items/PHN-PIXEL-9
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"quantity": 0}

### Take a Variant out: 200 with the rest of the Cart
DELETE {{cart}}/cart/items/AUD-JBL-FLIP-6
Authorization: Bearer {{customerToken}}

### Empty the Cart: 204
DELETE {{cart}}/cart
Authorization: Bearer {{customerToken}}

### Without a token: 401
GET {{cart}}/cart

### Staff have no Cart: 403
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=dev-cli&username=staff@ecomm.local&password=staff

> {% client.global.set("staffToken", response.body.access_token); %}

###
GET {{cart}}/cart
Authorization: Bearer {{staffToken}}

### Orchestration token: the checkout Saga's own identity, for the commands it calls
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=orchestration&client_secret=orchestration-dev-secret

> {% client.global.set("orchestrationToken", response.body.access_token); %}

### The demo Customer's ID: the sub Orchestration names in the body
GET http://localhost:8180/realms/ecomm/protocol/openid-connect/userinfo
Authorization: Bearer {{customerToken}}

> {% client.global.set("customerId", response.body.sub); %}

### Put something back in the Cart for the Saga to clear
PUT {{cart}}/cart/items/PHN-PIXEL-9
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"quantity": 1}

### Orchestration clears the named Customer's Cart: 204; sending it again is the same 204
POST {{cart}}/carts/clear
Authorization: Bearer {{orchestrationToken}}
Content-Type: application/json

{"customerId": "{{customerId}}"}

### Empty now
GET {{cart}}/cart
Authorization: Bearer {{customerToken}}

### A Customer can't: 403
POST {{cart}}/carts/clear
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"customerId": "{{customerId}}"}
