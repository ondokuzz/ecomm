<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><title>Your replacement for {{rma.reference}} is on its way</title></head>
<body style="font-family: Helvetica, Arial, sans-serif; color: #1f2937; line-height: 1.5;">
  <p>Hello {{customer.givenName}},</p>
  <p>The replacement for your return <strong>{{rma.reference}}</strong>, from Order
    {{order.reference}}, has shipped:</p>
  <ul>
    {{#lines}}
    <li>{{quantity}} × {{name}}</li>
    {{/lines}}
  </ul>
  {{#tracking}}
  <p>It's with {{carrier}}, tracking number <strong>{{number}}</strong>.</p>
  {{/tracking}}
  <p>Ecomm</p>
</body>
</html>
