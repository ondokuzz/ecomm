# Exercises every Catalog endpoint against the compose stack (`docker compose up -d --build`).
# Run the requests top to bottom in the IntelliJ HTTP client; the token requests store tokens for
# the ones after them.

@catalog = http://localhost:8081
@keycloak = http://localhost:8180/realms/ecomm/protocol/openid-connect/token

### Staff token
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=dev-cli&username=staff@ecomm.local&password=staff

> {% client.global.set("staffToken", response.body.access_token); %}

### Customer token
POST {{keycloak}}
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=dev-cli&username=demo@ecomm.local&password=demo

> {% client.global.set("customerToken", response.body.access_token); %}

### Categories with their attribute definitions, no token needed
GET {{catalog}}/categories

### One Category
GET {{catalog}}/categories/phones

### A missing Category: 404
GET {{catalog}}/categories/garden-furniture

### Every Product, no token needed
GET {{catalog}}/products

### Products in a category
GET {{catalog}}/products?category=phones

### A Product with several Variants; each variants[].id is a Variant ID a Cart takes
GET {{catalog}}/products/PHN-PIXEL-9

### A missing Product: 404
GET {{catalog}}/products/NO-SUCH-SKU

### One Variant, its Price and axis values, with its Product's SKU, name and images
GET {{catalog}}/variants/PHN-PIXEL-9-OBSIDIAN-256

### A missing Variant: 404
GET {{catalog}}/variants/NO-SUCH-VARIANT

### Staff create a Product: 201
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "AUD-DEMO-BUDS",
  "name": "Demo Buds",
  "category": "audio",
  "attributes": {"brand": "Demo", "type": "In-ear", "wireless": "true"},
  "images": ["/images/products/aud-demo-buds/front.svg"],
  "variants": [
    {"id": "AUD-DEMO-BUDS", "axisValues": {}, "price": {"amountMinor": 4999, "currency": "EUR"}}
  ]
}

### Staff create a Product with two Variants along the phones' axes: 201
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "PHN-DEMO-PHONE",
  "name": "Demo Phone",
  "category": "phones",
  "attributes": {"brand": "Demo", "screen": "6.1 in"},
  "images": ["/images/products/phn-demo-phone/front.svg"],
  "variants": [
    {"id": "PHN-DEMO-PHONE", "axisValues": {"color": "Black", "storage": "128 GB"},
     "price": {"amountMinor": 49900, "currency": "EUR"}},
    {"id": "PHN-DEMO-PHONE-BLACK-256", "axisValues": {"color": "Black", "storage": "256 GB"},
     "price": {"amountMinor": 59900, "currency": "EUR"},
     "images": ["/images/products/phn-demo-phone/black-256.svg"]}
  ]
}

### Variants missing an axis value, or sharing one combination: 400 naming each Variant's field
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "PHN-DEMO-BAD",
  "name": "Bad Phone",
  "category": "phones",
  "attributes": {"brand": "Demo", "screen": "6.1 in"},
  "variants": [
    {"id": "PHN-DEMO-BAD-1", "axisValues": {"color": "Black", "storage": "128 GB"},
     "price": {"amountMinor": 100, "currency": "EUR"}},
    {"id": "PHN-DEMO-BAD-2", "axisValues": {"color": "Black"},
     "price": {"amountMinor": 100, "currency": "EUR"}},
    {"id": "PHN-DEMO-BAD-3", "axisValues": {"color": "Black", "storage": "128 GB"},
     "price": {"amountMinor": 100, "currency": "EUR"}}
  ]
}

### A Variant ID another Product already has: 409
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "PHN-DEMO-COPY",
  "name": "Copy Phone",
  "category": "phones",
  "attributes": {"brand": "Demo", "screen": "6.1 in"},
  "variants": [
    {"id": "PHN-PIXEL-9", "axisValues": {"color": "Black", "storage": "128 GB"},
     "price": {"amountMinor": 100, "currency": "EUR"}}
  ]
}

### Staff delete the demo phone: 204
DELETE {{catalog}}/products/PHN-DEMO-PHONE
Authorization: Bearer {{staffToken}}

### A Product breaking its Category's definitions: 400 naming each field in `errors`
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "AUD-DEMO-BAD",
  "name": "Bad Buds",
  "category": "audio",
  "attributes": {"type": "Earbuds", "wireless": "yes", "colour": "Pink"},
  "variants": [
    {"id": "AUD-DEMO-BAD", "axisValues": {}, "price": {"amountMinor": 4999, "currency": "EUR"}}
  ]
}

### A Product in a Category that doesn't exist: 400
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "GRD-DEMO-BENCH",
  "name": "Demo Bench",
  "category": "garden-furniture",
  "variants": [{"id": "GRD-DEMO-BENCH", "price": {"amountMinor": 4999, "currency": "EUR"}}]
}

### Creating it again: 409
POST {{catalog}}/products
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "sku": "AUD-DEMO-BUDS",
  "name": "Demo Buds",
  "category": "audio",
  "attributes": {"brand": "Demo", "type": "In-ear", "wireless": "true"},
  "variants": [
    {"id": "AUD-DEMO-BUDS", "axisValues": {}, "price": {"amountMinor": 4999, "currency": "EUR"}}
  ]
}

### Staff update it: 200
PUT {{catalog}}/products/AUD-DEMO-BUDS
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "name": "Demo Buds 2",
  "category": "audio",
  "attributes": {"brand": "Demo", "type": "In-ear", "wireless": "true"},
  "images": ["/images/products/aud-demo-buds/front.svg"],
  "variants": [
    {"id": "AUD-DEMO-BUDS", "axisValues": {}, "price": {"amountMinor": 3999, "currency": "EUR"}}
  ]
}

### A Customer may not change Products: 403
PUT {{catalog}}/products/AUD-DEMO-BUDS
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"name": "Hijacked", "category": "audio",
 "variants": [{"id": "AUD-DEMO-BUDS", "price": {"amountMinor": 1, "currency": "EUR"}}]}

### Nor may anyone without a token: 401
DELETE {{catalog}}/products/AUD-DEMO-BUDS

### Staff delete it: 204
DELETE {{catalog}}/products/AUD-DEMO-BUDS
Authorization: Bearer {{staffToken}}

### Gone: 404
GET {{catalog}}/products/AUD-DEMO-BUDS

### Staff create a Category: 201
POST {{catalog}}/categories
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "slug": "demo-cameras",
  "name": "Demo cameras",
  "attributes": [
    {"name": "brand", "type": "TEXT", "required": true, "variantAxis": false},
    {"name": "megapixels", "type": "NUMBER", "required": true, "variantAxis": false},
    {"name": "mount", "type": "ENUM", "values": ["E", "RF", "Z"], "required": false, "variantAxis": false},
    {"name": "color", "type": "TEXT", "required": true, "variantAxis": true}
  ]
}

### Creating it again: 409
POST {{catalog}}/categories
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{"slug": "demo-cameras", "name": "Demo cameras"}

### Staff change its name and definitions: 200. Existing Products are untouched until next written
PUT {{catalog}}/categories/demo-cameras
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "name": "Demo mirrorless cameras",
  "attributes": [
    {"name": "brand", "type": "TEXT", "required": true, "variantAxis": false},
    {"name": "megapixels", "type": "NUMBER", "required": true, "variantAxis": false},
    {"name": "weatherSealed", "type": "BOOLEAN", "required": false, "variantAxis": false}
  ]
}

### A Customer may not change Categories: 403
DELETE {{catalog}}/categories/demo-cameras
Authorization: Bearer {{customerToken}}

### Deleting a Category that still has Products: 409
DELETE {{catalog}}/categories/phones
Authorization: Bearer {{staffToken}}

### Staff delete an empty Category: 204
DELETE {{catalog}}/categories/demo-cameras
Authorization: Bearer {{staffToken}}
