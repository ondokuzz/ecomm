      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(temporal_workflow_endtoend_latency_seconds_sum{workflow_type=\"fulfillment\"}[$__rate_interval])) / sum(rate(temporal_workflow_endtoend_latency_seconds_count{workflow_type=\"fulfillment\"}[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ]
    }
