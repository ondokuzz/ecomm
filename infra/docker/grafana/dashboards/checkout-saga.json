          },
          "expr": "sum by (outcome) (round(increase(fulfillment_workflows_total[$__rate_interval])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Step failures",
      "description": "Failed attempts of each fulfillment step: a context that didn't answer, or refused. Every step after the capture is retried until it succeeds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
