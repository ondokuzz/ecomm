        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Outcomes in the time range",
      "description": "How every fulfillment Saga that ended in the time range ended: DELIVERED, CAPTURE_REFUSED (the Shipment is on hold and the Order stays Paid), DELIVERY_UNCONFIRMED (no delivery within the deadline, 30 days on the stack) or FAILED (the Shipment couldn't be created).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
