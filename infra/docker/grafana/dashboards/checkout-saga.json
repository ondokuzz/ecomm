          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Event lag (Orchestration's consumers)",
      "description": "Order and Shipment events not yet read by the groups that start and wake the fulfillment Saga, from the broker's committed offsets. It rises while Orchestration is down, then drains. A partition the group has never committed on reads -1 from the exporter and counts 0 here: the groups start from the latest offset, so it holds nothing for them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "0",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (group) (clamp_min(kafka_consumergroup_lag{group=~\"orchestration\\\\..*\"}, 0))",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Workflow duration (Temporal)",
      "description": "Mean time from a paid Order to the fulfillment Saga's end; most of it is Staff's packing and the Carrier's delivery.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
