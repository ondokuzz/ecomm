          },
          "expr": "sum by (step) (round(increase(fulfillment_step_failures_total[$__rate_interval])))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Shipments on hold",
      "description": "Shipments put on hold because their Payment's capture was declined (captureDeclined) or couldn't be made (captureFailed). Resolving them is Staff's.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
