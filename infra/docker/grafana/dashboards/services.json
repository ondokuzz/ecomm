    {
      "id": 14,
      "type": "timeseries",
      "title": "Limit refusals",
      "description": "Messages refused because a Customer had sent 20 in an hour or 100 in a day (429 assistantRateLimited), and turns refused at the ceiling of 60 calls to Claude a minute (503 assistantBusy).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
