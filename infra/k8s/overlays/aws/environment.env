# An example run's values, so CI can build and validate the overlay. replacements.yaml copies each
# into the fields that hold it; `make aws-up` builds a run's overlay over this one that does the
# same with the run's own, from Terraform's outputs (infra/aws/run-overlay.py).
KEYCLOAK_HOSTNAME=https://auth.ecomm.example.com
OIDC_AUTHORITY=https://auth.ecomm.example.com/realms/ecomm
STOREFRONT_URL=https://shop.ecomm.example.com
POSTGRES_HOST=ecomm.abcdefghijkl.eu-central-1.rds.amazonaws.com
REDIS_HOST=ecomm.abcdef.0001.euc1.cache.amazonaws.com
STOREFRONT_TARGET_GROUP=arn:aws:elasticloadbalancing:eu-central-1:000000000000:targetgroup/ecomm-shop/0000000000000000
ADMIN_CONSOLE_TARGET_GROUP=arn:aws:elasticloadbalancing:eu-central-1:000000000000:targetgroup/ecomm-admin/0000000000000000
API_GATEWAY_TARGET_GROUP=arn:aws:elasticloadbalancing:eu-central-1:000000000000:targetgroup/ecomm-api/0000000000000000
KEYCLOAK_TARGET_GROUP=arn:aws:elasticloadbalancing:eu-central-1:000000000000:targetgroup/ecomm-auth/0000000000000000
