    "test:e2e": "playwright test",
    "lint": "oxlint && prettier --check \"**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
