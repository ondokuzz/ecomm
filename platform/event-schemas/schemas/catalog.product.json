{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalog.product",
  "description": "A snapshot of a Product with every Variant, published whenever it is created, changed or removed. A removed Product's last event says so rather than being a tombstone. Keyed by sku.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "sku",
    "version",
    "change",
    "product"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique per event; the same event delivered twice has the same eventId."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the change was published, in the transaction that made it."
    },
    "sku": {
      "type": "string",
      "minLength": 1,
      "description": "The Product's SKU: the message key."
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "description": "The aggregate's version, which goes up by at least one with every change. Apply an event only if it is newer than what you hold."
    },
    "change": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPDATED",
        "REMOVED",
        "BACKFILLED"
      ],
      "description": "Why the event was published."
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "attributes",
        "images",
        "variants",
        "removed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "The Category's slug."
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Product-level attribute values by attribute name."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variantId",
              "axisValues",
              "price",
              "images"
            ],
            "properties": {
              "variantId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "axisValues": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "The Variant's value for each of the Category's variant axes."
              },
              "price": {
                "$ref": "#/definitions/Money"
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "removed": {
          "type": "boolean",
          "description": "True in the last event of a Product removed from the Catalog."
        }
      }
    }
  },
  "definitions": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "description": "An amount in a Currency's Minor unit (CONTEXT.md, Money).",
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "description": "The amount in its Currency's Minor unit."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The Currency's ISO 4217 code."
        }
      }
    }
  }
}
