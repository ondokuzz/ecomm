{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "service-template.greeting",
  "description": "Test-only: a Greeting's snapshot, as a real topic's schema in platform/event-schemas describes its aggregate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "greetingId",
    "version",
    "change",
    "greeting"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "greetingId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "change": {
      "type": "string",
      "enum": [
        "CREATED",
        "CHANGED"
      ]
    },
    "greeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
